# =============================================================================
# MLOps infrastructure + FEMTO-RUL environment template
#
# Setup:
#     cp .env.example .env
#
# Then place the real secret values only in .env.
#
# COMMIT:     .env.example
# DO NOT COMMIT: .env
# =============================================================================


# -----------------------------------------------------------------------------
# Existing MLOps infrastructure
# -----------------------------------------------------------------------------

BIND_ADDRESS=127.0.0.1

POSTGRES_USER=mlops
POSTGRES_PASSWORD=change-me

AIRFLOW_SECRET_KEY=change-me
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=change-me

MLFLOW_ARTIFACT_BUCKET=mlflow

MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=change-me

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me


# -----------------------------------------------------------------------------
# FEMTO-RUL application environment
# -----------------------------------------------------------------------------

APP_ENV=local


# -----------------------------------------------------------------------------
# Data
#
# Parent layout:
# data/raw/Training_set
# data/raw/Test_set
# data/raw/Validation_Set
# -----------------------------------------------------------------------------

FEMTO_DATA_ROOT=./data
FEMTO_RAW_DATA_DIR=./data/raw
FEMTO_EXTRACTED_DATA_DIR=./data/raw
FEMTO_PROCESSED_DATA_DIR=./data/processed
FEMTO_ARTIFACTS_DIR=./artifacts


# -----------------------------------------------------------------------------
# MLOps service endpoints
#
# These localhost values assume local SSH/port forwarding to the existing
# cloud environment. Docker/Airflow/cloud runtimes can inject different values.
# -----------------------------------------------------------------------------

AIRFLOW_BASE_URL=http://localhost:8080
MLFLOW_TRACKING_URI=http://localhost:5000
GRAFANA_BASE_URL=http://localhost:3000

# Human-facing MinIO console.
MINIO_CONSOLE_URL=http://localhost:9001

# MinIO S3-compatible API used by DVC and object-storage clients.
MINIO_ENDPOINT_URL=http://localhost:9000


# -----------------------------------------------------------------------------
# DVC / MinIO
# -----------------------------------------------------------------------------

DVC_REMOTE_NAME=minio
DVC_REMOTE_URL=s3://mlops-rul-dvc


# -----------------------------------------------------------------------------
# MLflow application naming
# -----------------------------------------------------------------------------

MLFLOW_EXPERIMENT_NAME=femto-rul
MLFLOW_MODEL_NAME=femto-rul-model
MLFLOW_MODEL_ALIAS=candidate


# -----------------------------------------------------------------------------
# Inference telemetry (Phase 16)
#
# Defaults assume the app runs as a docker-compose service on the same
# network as `postgres` (service name resolves as a hostname). Override
# INFERENCE_DB_HOST for local, non-compose development.
# -----------------------------------------------------------------------------

INFERENCE_DB_HOST=postgres
INFERENCE_DB_PORT=5432
INFERENCE_DB_NAME=inference
